# Copia este archivo como .env.local y rellena los valores (nunca los subas al repositorio).

# URL del proyecto: Supabase → Project Settings → API. No es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Secret key (sb_secret_...). SOLO servidor: no le pongas el prefijo NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# Opcional. La aplicación no la usa (toda la lectura y escritura pasa por el servidor).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# En producción (next start) la escritura está bloqueada por defecto porque el
# proyecto no tiene autenticación. Actívala solo tras proteger los endpoints.
# ETL_PERMITIR_ESCRITURA=true

# Clave de MapTiler para el mapa de ciudades (https://cloud.maptiler.com/account/keys).
# Es pública por diseño: restríngela a tus dominios en MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=
